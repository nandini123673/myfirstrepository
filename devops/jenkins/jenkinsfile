pipeline {
    agent any
    stages {
        stage("clone the code") {
            steps {
                echo "clone the code using git"
            }
        }
        stage("build the code using mvn") {
            steps {
                echo "build the code"
            }
        }
        stage("test the code") {
            steps {
                echo "test the code"
            }
            }
            stage("deploy the code") {
                steps {
                    echo "deploy the code"
                }
            }    
    }
}
